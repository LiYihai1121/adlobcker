# 仅保留运行所需文件，排除本地依赖/缓存/日志/数据，缩小构建上下文
# 语法：docker build 用此文件过滤 COPY . . 的内容
**/__pycache__/
**/*.pyc
**/*.pyo
.git/
.gitignore
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# 前端本地依赖由多阶段构建在镜像内重新安装，宿主机 node_modules 不入上下文
backend/frontend/node_modules/

# 运行时数据与本地环境配置（容器内由 settings 默认值/环境变量接管）
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
*.log

# 测试不进生产镜像
backend/tests/

# IDE/OS 杂项
.idea/
.vscode/
.DS_Store
Thumbs.db


# AdBlocker 生产反向代理配置（Caddy 自动申请并续期 HTTPS 证书）。
#
# 使用前把 your-domain.example 替换为你的真实域名，并确保该域名已解析到本服务器，
# 且防火墙放行 80/443。Caddy 会自动向 Let's Encrypt 申请证书。
#
# 局域网/无域名场景：去掉下面整段，改用
#   :80 { reverse_proxy adblocker-backend:8000 }   （仅 HTTP，不推荐公网使用）

your-domain.example {
    encode gzip
    reverse_proxy adblocker-backend:8000
}

# ===== AdBlocker Backend 环境变量示例 =====
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# SQLite 数据库文件路径
ADBLOCK_DB_PATH=data/adblock.db

# 远程规则同步间隔（小时）
SYNC_INTERVAL_HOURS=6

# CORS 允许来源（逗号分隔或 JSON 数组字符串）
# 生产环境建议收紧，例如：["http://10.0.2.2","https://your.domain"]
CORS_ORIGINS=["*"]

# 启动时是否立即执行一次远程同步
SYNC_ON_STARTUP=true

# 管理接口密钥（保护写接口：新增/删除域名、改弹窗规则）
# 生产环境务必设置；留空则不启用鉴权（仅本地开发）
ADBLOCK_ADMIN_KEY=


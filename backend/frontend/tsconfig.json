{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "strict": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "src",
    "outDir": "../app/static",
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}

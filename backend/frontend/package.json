{
  "name": "adblocker-console",
  "private": true,
  "version": "1.0.0",
  "description": "AdBlocker 浏览器控制台前端（TypeScript + Tailwind CSS + DaisyUI）",
  "scripts": {
    "build:js": "tsc",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i src/input.css -o ../app/static/style.css --minify",
    "build": "npm run build:js && npm run build:css",
    "watch:js": "tsc --watch",
    "watch:css": "tailwindcss -i src/input.css -o ../app/static/style.css --watch"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tailwindcss": "^3.4.0",
    "daisyui": "^4.12.0"
  }
}
